# Example profile for a VM you built and provisioned yourself.
#
# RUNTIME=qemu: more setup than the container runtime, and reproducible --
# the snapshot is restored every run, so two runs are comparable.
#
# Copy to `<name>.env` in this directory and edit. Real profiles are
# gitignored: they point at licensed Windows/Office images and may carry a
# host-specific SSH key path.
#
#   cp acceptance/powerpoint/profiles/example.env \
#      acceptance/powerpoint/profiles/ppt2016.env

# Human-readable; appears in diagnostics so a report says which PowerPoint ran.
VM_LABEL="PowerPoint 2016 on Windows 10"

# qcow2 disk. Kept outside git (see .gitignore). The script restores
# VM_SNAPSHOT before every run, so the disk is always left as it was found.
VM_DISK="/media/ffreis/second/vm/win10-ppt2016.qcow2"

# Internal qemu snapshot name holding the provisioned, logged-in state.
# Create it with the VM powered off:
#   qemu-img snapshot -c clean-provisioned <disk>
VM_SNAPSHOT="clean-provisioned"

VM_MEMORY_MB="4096"
VM_CPUS="2"

# Host port forwarded to the guest's OpenSSH. Must be unique per profile if
# two profiles ever run concurrently.
VM_SSH_PORT="2222"
VM_SSH_USER="tester"
VM_SSH_KEY="${HOME}/.ssh/ppt-acceptance"

# Where the guest keeps the harness and its inputs. Must match the working
# directory baked into the scheduled task (see README.md).
GUEST_WORKDIR="C:/ppt-acceptance"

# The scheduled task that runs pytest in the logged-in interactive session.
# A command run over SSH lands in a non-interactive session where PowerPoint
# automation does not reliably work, which is why this indirection exists.
GUEST_TASK="PptAcceptance"
